{
  "name": "reality-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "packages/*",
    "web",
    "server"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev --workspace @reality-builder/web",
    "dev:server": "npm run dev --workspace @reality-builder/server",
    "build:packages": "npm run build --workspace @reality-builder/shared && npm run build --workspace @reality-builder/spatial-engine",
    "build:server": "npm run build --workspace @reality-builder/server",
    "build:web": "npm run build --workspace @reality-builder/web",
    "build": "npm run build:packages && npm run build:server && npm run build:web",
    "start": "node scripts/start.mjs",
    "typecheck": "npm run build:packages && npm run typecheck --workspace @reality-builder/server && npm run typecheck --workspace @reality-builder/web",
    "test": "npm run build:packages && vitest run --config vitest.config.ts",
    "dev:share": "RB_HOST=0.0.0.0 node scripts/dev.mjs",
    "tunnel": "node scripts/tunnel.mjs",
    "share": "node scripts/share.mjs",
    "smoke:collab": "node scripts/collab-smoke.mjs",
    "aws:release": "node scripts/aws/build-release.mjs",
    "aws:deploy": "node scripts/aws/deploy.mjs",
    "aws:secret": "node scripts/aws/secret.mjs",
    "aws:migrate": "node --import tsx/esm server/scripts/migrate-to-aws.ts",
    "aws:test-local": "node scripts/aws/test-local.mjs"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "@types/node": "^22.8.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vite": "^7.1.2",
    "vitest": "^3.2.4"
  }
}
